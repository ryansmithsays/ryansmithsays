<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <meta name="theme-color" content="#0a1830">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ ogTitle or title }}">
  <meta property="og:description" content="{{ ogDescription or description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta name="twitter:card" content="summary_large_image">

  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%230a1830'/%3E%3Ctext x='32' y='46' font-size='40' font-family='Arial Black,Arial,sans-serif' font-weight='900' text-anchor='middle' fill='%23e6bd55'%3ES%3C/text%3E%3C/svg%3E">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,500;0,600;0,700;0,800;1,800&family=Caveat:wght@500&family=Inter:wght@400;500;600&family=Instrument+Serif:ital@1&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/css/styles.css' | url }}">
</head>
<body id="top">
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="site-header__inner">
      <a class="wordmark" href="{{ '/' | url }}" aria-label="{{ site.name }}, home">Ryan Smith <span>Says</span></a>
      <nav class="site-nav" aria-label="Primary">
        {%- for item in site.nav %}
        <a href="{% if item.internal %}{{ item.href | url }}{% else %}{{ item.href }}{% endif %}">{{ item.text }}</a>
        {%- endfor %}
      </nav>
      <a class="btn btn--gold btn--sm" href="{{ site.contactUrl }}">Let's talk</a>
    </div>
  </header>

  <main id="main">
{{ content | safe }}
  </main>
</body>
</html>
