---
layout: layouts/base.njk
pageCss: /css/page.css
---
    <!-- PAGE HERO -->
    <section class="page-hero{% if portrait %} page-hero--photo{% endif %}" aria-labelledby="page-title">
      <div class="page-hero__inner">
        <div class="page-hero__copy">
          {%- if eyebrow %}
          <p class="eyebrow eyebrow--rule">{{ eyebrow }}</p>
          {%- endif %}
          <h1 id="page-title" class="page-hero__title">{{ heading or title }}</h1>
          {%- if lede %}
          <p class="page-hero__lede">{{ lede }}</p>
          {%- endif %}
        </div>
        {%- if portrait %}
        <!-- Portrait comes from --photo-portrait in css/styles.css -->
        <div class="page-hero__photo" role="img" aria-label="{{ portraitAlt }}"></div>
        {%- endif %}
      </div>
    </section>

{{ content | safe }}

    <!-- CLOSING CTA (override any part with ctaEyebrow, ctaTitle, ctaLabel, ctaHref, ctaTag) -->
    <section id="contact" class="closing" aria-labelledby="closing-title">
      <div class="closing__inner">
        <div>
          <p class="eyebrow eyebrow--rule eyebrow--light">{{ ctaEyebrow or "Ready to dive in?" }}</p>
          <h2 id="closing-title" class="closing__title">{{ (ctaTitle or "Let's create something <em>extraordinary.</em>") | safe }}</h2>
        </div>
        <a class="btn btn--gold" href="{{ ctaHref or site.contactUrl }}">{{ ctaLabel or "Let's have a chat" }}</a>
        <p class="closing__tag">{{ (ctaTag or "Full-time roles.<br>Speaking.<br>Storytelling.<br>Collaborations.") | safe }}</p>
      </div>
    </section>
